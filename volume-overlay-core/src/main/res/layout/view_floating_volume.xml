<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/layoutOverlayContainer"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_floating_overlay"
    android:elevation="12dp"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="6dp">

    <!-- Drag Handle Area -->
    <ImageView
        android:id="@+id/ivDragHandle"
        android:layout_width="32dp"
        android:layout_height="14dp"
        android:layout_marginBottom="4dp"
        android:contentDescription="@string/desc_drag_handle"
        android:src="@drawable/ic_drag_handle" />

    <!-- Volume Up Button (+) -->
    <ImageButton
        android:id="@+id/btnVolumeUp"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_volume_button"
        android:contentDescription="@string/desc_volume_up"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_volume_up" />

    <!-- Live Volume Level Indicator Text -->
    <TextView
        android:id="@+id/tvVolumePercentage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:textColor="@color/overlay_icon_tint"
        android:textSize="12sp"
        android:textStyle="bold"
        android:text="70%" />

    <!-- Mini Vertical Volume Progress Indicator -->
    <ProgressBar
        android:id="@+id/pbVolumeLevel"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="32dp"
        android:layout_height="4dp"
        android:layout_marginBottom="4dp"
        android:max="100"
        android:progress="70"
        android:progressTint="@color/overlay_accent" />

    <!-- Volume Down Button (-) -->
    <ImageButton
        android:id="@+id/btnVolumeDown"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_volume_button"
        android:contentDescription="@string/desc_volume_down"
        android:padding="10dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_volume_down" />

    <!-- Divider Line -->
    <View
        android:layout_width="24dp"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="@color/overlay_border" />

    <!-- Quick Mute / Unmute Button -->
    <ImageButton
        android:id="@+id/btnVolumeMute"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_volume_button"
        android:contentDescription="@string/desc_volume_mute"
        android:padding="9dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_volume_mute" />

    <!-- Expand Detailed Multi-Stream Sliders Button -->
    <ImageButton
        android:id="@+id/btnExpandPanel"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginTop="2dp"
        android:background="@drawable/bg_volume_button"
        android:contentDescription="@string/desc_volume_expand"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_expand_panel" />

</LinearLayout>
